VITE_ANALYTICS_API_URL=https://pinnned-analytics-production.up.railway.app

# Firebase (Remote Config + Analytics, A/B 테스트용). 콘솔 > 프로젝트 설정 > 내 앱(웹) SDK 설정에서 복사.
# 비어 있으면 Firebase 없이 동작한다 (GA는 기존 gtag 로더로 수집).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 운영 에러 → 노션 QA DB 기록 (/report-error 서버 라우트 전용, 클라이언트에 노출되지 않음).
# 비어 있으면 수신 라우트가 기록 없이 204만 돌려준다. DB 생성: node scripts/qa-notion.mjs create-db --parent <pageId>
NOTION_TOKEN=
NOTION_QA_DB_ID=
